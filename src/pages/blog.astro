---
import getReadingtime from "reading-time";
import { SITE_TITLE } from "../config";
import { getPublishedPosts } from "../util/posts";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BlogPosts } from "../components/BlogPosts";

const posts = await getPublishedPosts();

const blogPosts = posts.map((post) => ({
  frontmatter: {
    ...post.data,
    readingTime: getReadingtime(post.body).text,
  },
  url: `/blog/${post.slug}`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${SITE_TITLE} blog`}
      description="Writings on programming and tech"
    />
  </head>
  <body>
    <Header />
    <main>
      <h1 class="pb-4">Blog</h1>

      <p>
        I don't really write much here, as I usually write notes on my{" "}
        <a href="https://quartz.durocodes.me/">Quartz</a> instance.
      </p>
      <br />

      <BlogPosts posts={blogPosts} client:load />
    </main>
    <Footer />
  </body>
</html>
