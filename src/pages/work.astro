---
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Project from "../components/Project.astro";
import Experience from "../components/Experience.astro";
import { experience, loadRepoStats, pinnedRepos } from "../data/work";

const stats = await loadRepoStats();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={`${SITE_TITLE} work`}
      description={`${SITE_DESCRIPTION} — experience and projects`}
    />
  </head>

  <body>
    <Header />
    <main class="text-lg text-neutral-200">
      <h1 class="text-4xl pb-6">Work</h1>

      <h2 class="text-3xl pb-4">Experience</h2>

      <section class="grid grid-cols-1 gap-4 auto-cols-max pb-10">
        {experience.map((role) => <Experience {...role} />)}
      </section>

      <h2 class="text-3xl pb-4">Projects</h2>

      <section
        class="grid grid-cols-1 gap-4 auto-cols-max sm:grid-cols-2 sm:gap-3"
      >
        {
          Object.entries(pinnedRepos).map(([repo, language]) => (
            <Project
              repo={repo}
              language={language}
              stars={stats[repo]?.stars}
              forks={stats[repo]?.forks}
            />
          ))
        }
      </section>
    </main>
    <Footer />
    <script>
      import { githubReposUrl, repoStats } from "../data/work";

      const refreshRepoStats = async () => {
        const response = await fetch(githubReposUrl, {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (!response.ok) return;

        const stats = repoStats(await response.json());

        document.querySelectorAll("[data-repo]").forEach((card) => {
          const name = card.getAttribute("data-repo");
          const repo = name ? stats[name] : undefined;
          if (!repo) return;

          const stars = card.querySelector("[data-stars]");
          const forks = card.querySelector("[data-forks]");
          if (stars) stars.textContent = repo.stars;
          if (forks) forks.textContent = repo.forks;
        });
      };

      refreshRepoStats();
    </script>
  </body>
</html>
