---
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Project from "../components/Project.astro";
import Experience from "../components/Experience.astro";
import { experience, pinnedRepos } from "../data/work";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={`${SITE_TITLE} work`}
      description={`${SITE_DESCRIPTION} — experience and projects`}
    />
  </head>

  <body>
    <Header />
    <main class="text-lg text-neutral-200">
      <h1 class="text-4xl pb-6">Work</h1>

      <h2 class="text-3xl pb-4">Experience</h2>

      <section class="grid grid-cols-1 gap-4 auto-cols-max pb-10">
        {experience.map((role) => <Experience {...role} />)}
      </section>

      <h2 class="text-3xl pb-4">Projects</h2>

      <section
        class="grid grid-cols-1 gap-4 auto-cols-max sm:grid-cols-2 sm:gap-3"
      >
        {pinnedRepos.map((repo) => <Project repo={repo} />)}
      </section>
    </main>
    <Footer />
    <script>
      import { pinnedReposUrl } from "../data/work";

      const text = (value: unknown) => (typeof value === "string" ? value : "");

      const count = (value: unknown) =>
        typeof value === "number" ? String(value) : "";

      const loadPinnedRepos = async () => {
        const response = await fetch(pinnedReposUrl);
        if (!response.ok) return;

        const body: unknown = await response.json();
        if (!Array.isArray(body)) return;

        const byName = new Map(
          body.flatMap((repo) => {
            if (
              typeof repo !== "object" ||
              repo === null ||
              !("name" in repo) ||
              typeof repo.name !== "string"
            ) {
              return [];
            }

            return [[repo.name, repo] as const];
          }),
        );

        document.querySelectorAll("[data-repo]").forEach((card) => {
          const name = card.getAttribute("data-repo");
          const repo = name ? byName.get(name) : undefined;
          if (!repo) return;

          const description = card.querySelector("[data-description]");
          const stars = card.querySelector("[data-stars]");
          const forks = card.querySelector("[data-forks]");
          const language = card.querySelector("[data-language]");
          const languageColor = card.querySelector("[data-language-color]");
          const languageGroup = card.querySelector("[data-language-group]");

          if (description) description.textContent = text(repo.description);
          if (stars) stars.textContent = count(repo.stars) || "–";
          if (forks) forks.textContent = count(repo.forks) || "–";

          const languageName = text(repo.language);
          if (!languageName || !language || !languageGroup) return;

          language.textContent = languageName;
          languageGroup.classList.remove("hidden");
          languageGroup.classList.add("inline-flex");

          const color = text(repo.languageColor);
          if (languageColor && /^#[0-9a-fA-F]{3,8}$/.test(color)) {
            languageColor.setAttribute("style", `background-color: ${color}`);
          }
        });
      };

      loadPinnedRepos();
    </script>
  </body>
</html>
