---
import { githubUser } from "../data/work";

interface Props {
  repo: string;
  language: string;
  stars?: string;
}

const { repo, language, stars = "–" } = Astro.props;
---

<a
  href={`https://github.com/${githubUser}/${repo}`}
  target="_blank"
  data-repo={repo}
  class="hover:no-underline"
>
  <div
    class="flex flex-col justify-between gap-y-4 border border-neutral-700 bg-themeBlack hover:scale-105 ease-out transition-transform p-4 rounded-xl"
  >
    <span class="text-xl font-medium">{repo}</span>
    <div class="flex flex-wrap items-center gap-x-2 text-(sm neutral-200)">
      <div class="flex gap-x-1 items-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
          ></path>
        </svg>
        <span data-stars>{stars}</span>
      </div>

      <span>•</span>
      <span>{language}</span>
    </div>
  </div>
</a>
